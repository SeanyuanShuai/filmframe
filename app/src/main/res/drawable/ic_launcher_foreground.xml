<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!--
        Adaptive icon foreground.
        Safe content zone is the center 66×66. Outer 21dp may be cropped to
        squircle/circle by the launcher.

        Composition: a framed photo silhouette.
            - off-white mat (FAFAFA), slightly taller bottom margin
            - inner photo as deep slate
            - subtle diagonal highlight (mimics glass / glossy print)
            - 4-dot caption row (recalls EXIF · separators)
            - tiny gold corner dot = signature/watermark hint
    -->

    <!-- Outer photo card (white mat) -->
    <path
        android:pathData="M30,30 L78,30 Q80,30 80,32 L80,76 Q80,78 78,78 L30,78 Q28,78 28,76 L28,32 Q28,30 30,30 Z"
        android:fillColor="#FAFAFA"/>

    <!-- Inner photo (deep slate) -->
    <path
        android:pathData="M33,33 L75,33 L75,65 L33,65 Z"
        android:fillColor="#222B33"/>

    <!-- Glossy highlight -->
    <path
        android:pathData="M33,33 L75,33 L48,65 L33,65 Z"
        android:fillColor="#2E3A45"
        android:fillAlpha="0.55"/>

    <!-- Caption hairline -->
    <path
        android:pathData="M40,69.6 L68,69.6 L68,71.0 L40,71.0 Z"
        android:fillColor="#1A1A1A"
        android:fillAlpha="0.65"/>

    <!-- Caption second-line dots (4 dots, evenly spaced) -->
    <path
        android:pathData="M44,73.6 m-1,0 a1,1 0 1,1 2,0 a1,1 0 1,1 -2,0 M51,73.6 m-1,0 a1,1 0 1,1 2,0 a1,1 0 1,1 -2,0 M58,73.6 m-1,0 a1,1 0 1,1 2,0 a1,1 0 1,1 -2,0 M65,73.6 m-1,0 a1,1 0 1,1 2,0 a1,1 0 1,1 -2,0"
        android:fillColor="#1A1A1A"
        android:fillAlpha="0.45"/>

    <!-- Accent corner dot (watermark hint) -->
    <path
        android:pathData="M73,73 m-1.6,0 a1.6,1.6 0 1,1 3.2,0 a1.6,1.6 0 1,1 -3.2,0"
        android:fillColor="#D4A24A"/>
</vector>
