<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!--
        JustFrame adaptive icon foreground.
        Safe content zone is the center 66×66. Outer 21dp may be cropped to
        squircle/circle by the launcher.

        Distilled to three elements only:
            1. Off-white photo card with bottom-heavy mat (Polaroid proportion)
            2. Inner photo block in deep slate
            3. Serif "J" mark engraved in the bottom mat (the "caption")
            4. Single gold dot lower-right, signature-style

        Reasoning: the previous icon stacked 5 visual elements; reads as
        "busy" at launcher size (48×48dp on most devices). Three elements
        with clear hierarchy give a Magnum / Aperture printed-monograph feel.
    -->

    <!-- White photo card with rounded corners; bottom mat ~16 units tall -->
    <path
        android:pathData="M26,24 L82,24 Q84,24 84,26 L84,82 Q84,84 82,84 L26,84 Q24,84 24,82 L24,26 Q24,24 26,24 Z"
        android:fillColor="#F5F1EA"/>

    <!-- Inner photo (deep slate, slightly cool) -->
    <path
        android:pathData="M30,30 L78,30 L78,66 L30,66 Z"
        android:fillColor="#1E2630"/>

    <!-- Subtle horizon line inside photo for "image" feel -->
    <path
        android:pathData="M30,52 L78,52 L78,53.2 L30,53.2 Z"
        android:fillColor="#2A3540"/>

    <!-- Serif "J" mark in the bottom mat —
         constructed from a vertical stem + quarter-arc hook + top serif cap.
         Color: warm near-black. -->
    <path
        android:pathData="M52,71 L52,77 Q52,79.4 49.6,79.4 Q47.2,79.4 47.2,77 L48.8,77 Q48.8,78.2 49.6,78.2 Q50.4,78.2 50.4,77 L50.4,71 Z M49.4,70 L54.6,70 L54.6,71.2 L49.4,71.2 Z"
        android:fillColor="#1A1A1A"/>

    <!-- Gold signature dot lower-right of card -->
    <path
        android:pathData="M77,78 m-2,0 a2,2 0 1,1 4,0 a2,2 0 1,1 -4,0"
        android:fillColor="#E4B86E"/>
</vector>
